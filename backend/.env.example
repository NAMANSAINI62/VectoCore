# Application
APP_ENV=development
SECRET_KEY=change-this-secret-key-in-production-min-32-chars
PORT=9417
PYTHONDONTWRITEBYTECODE=1

# PostgreSQL (Cloud examples: Neon / Supabase / Render - postgres:// & ?sslmode=require auto-convert for asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@your-cloud-postgres-host:5432/semantic_cache_db?ssl=require

# Redis (Cloud examples: Redis Cloud redis:// or Upstash rediss://)
REDIS_URL=redis://default:your-redis-password@your-redis-host:your-redis-port
REDIS_SOCKET_TIMEOUT=2.0
REDIS_CONNECT_TIMEOUT=2.0

# AI Provider Keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
COHERE_API_KEY=
NVIDIA_API_KEY=
MISTRAL_NVIDIA_API_KEY=
NVIDIA_EMBED_API_KEY=
EMBEDDING_MODEL_NAME=nvidia/nemotron-3.5-embed-1b

CHAT_DEFAULT_PROVIDER=groq
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
GROQ_AVAILABLE_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_AVAILABLE_MODELS=baidu/ernie-5.5-flash-preview:free
GEMINI_AVAILABLE_MODELS=gemini-flash-lite-latest
CLOUDFLARE_AVAILABLE_MODELS=@cf/qwen/qwen2.5-coder-32b-instruct
COHERE_AVAILABLE_MODELS=command-a-03-2025
NVIDIA_AVAILABLE_MODELS=nvidia/nemotron-3.5-super-vl-120b-a12b
MISTRAL_AVAILABLE_MODELS=mistralai/mistral-large-4-1t-a52b
TEXT_TO_SPEECH_MODEL=fish-audio/s2.1-pro-free:free
OPENROUTER_TIMEOUT_SECONDS=90

TTS_PCM_SAMPLE_RATE=24000

# JWT & Authentication (In production HTTPS deploy, set COOKIE_SECURE=true)
JWT_SECRET_KEY=your-super-secret-jwt-key-minimum-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Production Domain & CORS
FRONTEND_URL=http://localhost:4317
CORS_ORIGINS=http://localhost:4317,http://127.0.0.1:4317
