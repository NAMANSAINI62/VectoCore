# Server-side proxy target used by src/app/api/[...path]/route.ts
# Local dev: http://127.0.0.1:9417
# Cloud deploy (Vercel/Render/Railway): https://your-backend-service.onrender.com
BACKEND_INTERNAL_URL=http://127.0.0.1:9417

# Optional public base URL (client calls use /api/... through the built-in Next.js proxy)
NEXT_PUBLIC_API_BASE_URL=
