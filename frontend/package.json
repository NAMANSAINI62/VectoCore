{
  "name": "semantic-caching-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "dev": "next dev --turbopack -p 4317",
    "build": "next build",
    "start": "next start -p 4317",
    "serve": "next build && next start -p 4317",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@reduxjs/toolkit": "^2.14.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2"
  }
